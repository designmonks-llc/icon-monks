{
  "name": "@icon-monks/web",
  "version": "0.3.0",
  "description": "Icon Monks as a <icon-monks> custom element. Works in any framework or plain HTML.",
  "license": "MIT",
  "author": "Design Monks",
  "homepage": "https://designmonks.github.io/icon-monks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/designmonks/icon-monks.git"
  },
  "keywords": [
    "icons",
    "icon",
    "icon-library",
    "svg",
    "svg-icons",
    "open-source-icons",
    "icon-set",
    "react-icons",
    "vue-icons",
    "web-components",
    "icon-font",
    "icon-monks"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/icon-monks.js",
  "jsdelivr": "./dist/icon-monks.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "default": "./dist/all.js"
    },
    "./cdn": "./dist/icon-monks.js",
    "./cdn-all": "./dist/icon-monks.all.js",
    "./icons/*": "./dist/icons/*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true
}
