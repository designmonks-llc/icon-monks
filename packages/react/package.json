{
  "name": "@icon-monks/react",
  "version": "0.4.1",
  "description": "Icon Monks for React: tree-shakeable components in six weights.",
  "license": "MIT",
  "author": "Design Monks (https://monks.company/)",
  "homepage": "https://www.iconmonks.co/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/designmonks-llc/icon-monks.git"
  },
  "keywords": [
    "icons",
    "icon",
    "icon-library",
    "svg",
    "svg-icons",
    "open-source-icons",
    "icon-set",
    "react-icons",
    "vue-icons",
    "web-components",
    "icon-font",
    "icon-monks"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=16.8"
  }
}
