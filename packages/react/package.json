{
  "name": "@icon-monks/react",
  "version": "0.2.0",
  "description": "Icon Monks for React: tree-shakeable components in six weights.",
  "license": "MIT",
  "author": "Design Monks",
  "homepage": "https://github.com/designmonks/icon-monks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/designmonks/icon-monks.git"
  },
  "keywords": [
    "icons",
    "icon",
    "svg",
    "icon-monks"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=16.8"
  }
}
