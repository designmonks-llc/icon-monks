{
  "name": "@icon-monks/core",
  "version": "0.2.0",
  "description": "Icon Monks: raw SVG assets, sprites, metadata and a toSvg() helper.",
  "license": "MIT",
  "author": "Design Monks",
  "homepage": "https://designmonks.github.io/icon-monks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/designmonks/icon-monks.git"
  },
  "keywords": [
    "icons",
    "icon",
    "icon-library",
    "svg",
    "svg-icons",
    "open-source-icons",
    "icon-set",
    "react-icons",
    "vue-icons",
    "web-components",
    "icon-font",
    "icon-monks"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons.json": "./dist/icons.json",
    "./sprite/*": "./dist/sprite/*",
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets"
  ]
}
